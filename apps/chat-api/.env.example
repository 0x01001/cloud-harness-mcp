# Standalone Chat API only. Do not combine with the root MCP .env.example.
# Copy to apps/chat-api/.env in this checkout; npm run start:chat loads it by default.
# Default is derived from the module/repo location, never the working directory.
# This exact app .env is the ONLY checkout exception: owner-owned regular file
# at exact 0600; its owner-owned app directory may be 0755, but not group/world
# writable. Neither the file nor its immediate parent may be a symlink.
# All other private files stay outside the checkout: files 0600, parent 0700.
# Replace all operator placeholders below before starting; never commit secrets.
# Values are parsed as data: no $HOME, ~, or shell expansion inside this file.
# Optional CHAT_CONFIG_FILE override: absolute external private config path in
# the process environment, never inside this file (same 0600/0700 private rules).
# Node >=24 and npm ci required. Foreground: npm run build:chat && npm run start:chat

# Listener is always 127.0.0.1; this does not change MCP ports.
CHAT_API_PORT=3211

# Required absolute primary client Bearer key file, separate from the provider key.
# After preparing this private .env: make gen (or npm run chat:gen), which builds chat.
# First run creates a missing primary; later runs preserve it and add random UUID.key
# files under ${CHAT_API_KEY_FILE}.d. Each key: crypto.randomBytes(32).toString('hex').
# External key files 0600, directories 0700; unsafe entries/permissions/symlinks reject.
# make gen / npm --silent run chat:gen print only the freshly generated 64-hex key
# plus a newline (build diagnostics on stderr); plain npm adds banners.
# Copy the key directly into Authorization: Bearer <chat-key>, never a path/provider key.
# The file is persisted internally for server auth; old/provider keys are not printed.
# Terminal output is sensitive: avoid CI/shared logs and share the key securely.
# All keys grant full inference with shared limits/quota, not per-user/admin rights.
# No automatic service control/reload: restart foreground, or make stop then make start
# for an installed runtime; make start alone does not restart an already-running app.
# Revoke one generated key: remove only its .d/<UUID>.key file, then restart.
# Never overwrite the primary or reuse provider/MCP/ngrok keys.
CHAT_API_KEY_FILE="/Users/operator/Library/Application Support/cloudharness-chat/chat.key"
# Your OpenAI-compatible provider key is inline here; no provider.key file.
CHAT_UPSTREAM_API_KEY=<provider-api-key>

# Public HTTPS upstream ending in /v1; must support native Chat, Responses, models.
# No private/loopback upstreams, URL credentials, query strings, or redirects.
CHAT_UPSTREAM_BASE_URL=https://<public-provider-host>/v1
# Comma-separated exact upstream model IDs; prefixes such as openai/ are retained.
CHAT_ALLOWED_MODELS=<exact-native-model-id>

# Optional for foreground loopback use; REQUIRED for ngrok lifecycle commands.
# Uncomment and replace with the exact account-assigned hostname (no https://).
# CHAT_PUBLIC_HOST=your-assigned-host.ngrok-free.app
# Store the ngrok authtoken in ngrok's private config, not this file.

# Optional overrides shown at their defaults. Limits are not provider spend caps.
# CHAT_MAX_REQUEST_BYTES=4194304
# CHAT_MAX_RESPONSE_BYTES=16777216
# CHAT_MAX_CONCURRENT_REQUESTS=4
# CHAT_REQUESTS_PER_MINUTE=60
# CHAT_REQUEST_DEADLINE_MS=300000
